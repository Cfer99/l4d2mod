$jigglebone "Left_HairSide.001"
{
	is_flexible
	{
		length 15
		tip_mass 0
		pitch_stiffness 80
		pitch_damping 8
		yaw_stiffness 80
		yaw_damping 8
		allow_length_flex
		along_stiffness 100
		along_damping 0
		pitch_constraint -5 5
		pitch_friction 0
		pitch_bounce 0
		angle_constraint 5
	}
}
