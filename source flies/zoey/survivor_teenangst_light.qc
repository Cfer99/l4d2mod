$jigglebone "Left_Boing"
{
	is_flexible
	{
		length 5
		tip_mass 10
		pitch_stiffness 200
		pitch_damping 8
		yaw_stiffness 200
		yaw_damping 8
		allow_length_flex
		along_stiffness 100
		along_damping 0
		angle_constraint 3
	}
	has_base_spring
	{
		base_mass 0
		stiffness 200
		damping 6
		left_constraint -0.1 0.1
		left_friction 0
		up_constraint -0.1 0.1
		up_friction 0
		forward_constraint -0.1 0.1
		forward_friction 0
	}
}
