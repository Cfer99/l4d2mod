// The 32 below is a guess until further is known about the format.
$animblocksize 32 nostall
$bonesaveframe "ValveBiped.Bip01_Pelvis" position
$poseparameter "body_pitch" -90 90 loop 360
$poseparameter "body_yaw" -90 90 loop 360
$poseparameter "head_pitch" -90 90 loop 360
$poseparameter "head_yaw" -90 90 loop 360
$ikchain "rhand" "ValveBiped.Bip01_R_Hand" knee 0.707 0.707 0
$ikchain "lhand" "ValveBiped.Bip01_L_Hand" knee 0.707 0.707 0
$ikchain "rfoot" "ValveBiped.Bip01_R_Foot" knee 0.707 -0.707 0
$ikchain "lfoot" "ValveBiped.Bip01_L_Foot" knee 0.707 -0.707 0
$ikchain "ikclip" "ValveBiped.weapon_bone_Clip" knee 0.707 -0.707 0
$ikautoplaylock "rfoot" 1 0.1
$ikautoplaylock "lfoot" 1 0.1
$sequence "TeenAngst" {
	"miku_rabbit_pm.smd"
	fadein 0.2
	fadeout 0.2
	fps 30
	ikrule "rhand" release
	ikrule "lhand" release
	ikrule "rfoot" release
	ikrule "lfoot" release
	ikrule "ikclip" release
}
$sequence "ragdoll" {
	"miku_rabbit_pm.smd"
	activity "ACT_DIERAGDOLL" 1
	fadein 0.2
	fadeout 0.2
	fps 30
	ikrule "rhand" release
	ikrule "lhand" release
	ikrule "rfoot" release
	ikrule "lfoot" release
	ikrule "ikclip" release
}
$sequence "dlc1_intro_zoey_idle" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_idle.smd"
	fadein 0.2
	fadeout 0.2
	fps 30
	loop
	ikrule "rhand" release
	ikrule "lhand" release
	ikrule "rfoot" release
	ikrule "lfoot" release
	ikrule "ikclip" release
}
$sequence "dlc1_intro_zoey_shrug" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_shrug.smd"
	activity "ACT_DLCINTRO_ZOEY_01" -1
	delta
	// This subtract option added by Crowbar to prevent jigglebone problems when delta sequences are recompiled.
	subtract "dlc1_intro_zoey_shrug" 0
	fadein 0.2
	fadeout 0.2
	fps 30
}
$sequence "dlc1_intro_zoey_shout" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_shout.smd"
	activity "ACT_DLCINTRO_ZOEY_02" -1
	delta
	// This subtract option added by Crowbar to prevent jigglebone problems when delta sequences are recompiled.
	subtract "dlc1_intro_zoey_shout" 0
	fadein 0.2
	fadeout 0.2
	fps 30
}
$sequence "dlc1_intro_zoey_headshake" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_headshake.smd"
	activity "ACT_DLCINTRO_ZOEY_03" -1
	delta
	// This subtract option added by Crowbar to prevent jigglebone problems when delta sequences are recompiled.
	subtract "dlc1_intro_zoey_headshake" 0
	fadein 0.2
	fadeout 0.2
	fps 30
}
$sequence "dlc1_intro_zoey_handflipR" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_handflipR.smd"
	activity "ACT_DLCINTRO_ZOEY_04" -1
	delta
	// This subtract option added by Crowbar to prevent jigglebone problems when delta sequences are recompiled.
	subtract "dlc1_intro_zoey_handflipR" 0
	fadein 0.2
	fadeout 0.2
	fps 30
}
$sequence "dlc1_intro_zoey_head_gesture" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_head_gesture.smd"
	activity "ACT_DLCINTRO_ZOEY_05" -1
	delta
	// This subtract option added by Crowbar to prevent jigglebone problems when delta sequences are recompiled.
	subtract "dlc1_intro_zoey_head_gesture" 0
	fadein 0.2
	fadeout 0.2
	fps 30
}
$sequence "dlc1_intro_zoey_generator_point" {
	"survivor_teenangst_light_anims\dlc1_intro_zoey_generator_point.smd"
	activity "ACT_DLCINTRO_ZOEY_06" -1
	delta
	// This subtract option added by Crowbar to prevent jigglebone problems when delta sequences are recompiled.
	subtract "dlc1_intro_zoey_generator_point" 0
	fadein 0.2
	fadeout 0.2
	fps 30
}
$sequence "reference" {
	"reference.smd"
	activity "ACT_DIERAGDOLL" 1
	fadein 0.2
	fadeout 0.2
	fps 30
}

$animation a_proportions "miku_rabbit_pm.smd" subtract reference 0
$sequence proportions a_proportions predelta autoplay
$collisionjoints "miku_rabbit_pm_physics.smd"
{
	$mass 90
	$inertia 10
	$damping 0.01
	$rotdamping 0
	$rootbone "ValveBiped.Bip01_Pelvis"


	$jointconstrain "ValveBiped.Bip01_Spine" x limit -20 20 0
	$jointconstrain "ValveBiped.Bip01_Spine" y limit -10 10 0
	$jointconstrain "ValveBiped.Bip01_Spine" z limit -20 10 0

	$jointconstrain "ValveBiped.Bip01_Spine1" x limit -20 20 0
	$jointconstrain "ValveBiped.Bip01_Spine1" y limit -10 10 0
	$jointconstrain "ValveBiped.Bip01_Spine1" z limit -20 10 0

	$jointconstrain "ValveBiped.Bip01_R_Clavicle" x limit -10 10 0
	$jointconstrain "ValveBiped.Bip01_R_Clavicle" y limit -20 20 0
	$jointconstrain "ValveBiped.Bip01_R_Clavicle" z limit -5 30 0

	$jointconstrain "ValveBiped.Bip01_L_Clavicle" x limit -10 10 0
	$jointconstrain "ValveBiped.Bip01_L_Clavicle" y limit -20 20 0
	$jointconstrain "ValveBiped.Bip01_L_Clavicle" z limit -5 30 0

	$jointconstrain "ValveBiped.Bip01_L_UpperArm" x limit -45 45 0
	$jointconstrain "ValveBiped.Bip01_L_UpperArm" y limit -45 50 0
	$jointconstrain "ValveBiped.Bip01_L_UpperArm" z limit -90 30 0

	$jointconstrain "ValveBiped.Bip01_L_Forearm" x limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_L_Forearm" y limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_L_Forearm" z limit -130 0 0

	$jointconstrain "ValveBiped.Bip01_L_Hand" x limit -45 45 0
	$jointconstrain "ValveBiped.Bip01_L_Hand" y limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_L_Hand" z limit -30 30 0

	$jointconstrain "ValveBiped.Bip01_R_UpperArm" x limit -45 45 0
	$jointconstrain "ValveBiped.Bip01_R_UpperArm" y limit -50 45 0
	$jointconstrain "ValveBiped.Bip01_R_UpperArm" z limit -90 30 0

	$jointconstrain "ValveBiped.Bip01_Neck1" x limit -10 10 0
	$jointconstrain "ValveBiped.Bip01_Neck1" y limit -15 15 0
	$jointconstrain "ValveBiped.Bip01_Neck1" z limit -20 20 0

	$jointconstrain "ValveBiped.Bip01_R_Forearm" x limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_R_Forearm" y limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_R_Forearm" z limit -130 0 0

	$jointconstrain "ValveBiped.Bip01_R_Hand" x limit -45 45 0
	$jointconstrain "ValveBiped.Bip01_R_Hand" y limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_R_Hand" z limit -30 30 0

	$jointconstrain "ValveBiped.Bip01_R_Thigh" x limit -15 15 0
	$jointconstrain "ValveBiped.Bip01_R_Thigh" y limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_R_Thigh" z limit -60 30 0

	$jointconstrain "ValveBiped.Bip01_R_Calf" x limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_R_Calf" y limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_R_Calf" z limit 0 110 0

	$jointconstrain "ValveBiped.Bip01_Head1" x limit -45 45 0
	$jointconstrain "ValveBiped.Bip01_Head1" y limit -10 10 0
	$jointconstrain "ValveBiped.Bip01_Head1" z limit -15 15 0

	$jointconstrain "ValveBiped.Bip01_L_Thigh" x limit -15 15 0
	$jointconstrain "ValveBiped.Bip01_L_Thigh" y limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_L_Thigh" z limit -60 30 0

	$jointconstrain "ValveBiped.Bip01_L_Calf" x limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_L_Calf" y limit 0 0 0
	$jointconstrain "ValveBiped.Bip01_L_Calf" z limit 0 110 0

	$jointconstrain "ValveBiped.Bip01_L_Foot" x limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_L_Foot" y limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_L_Foot" z limit -30 30 0

	$jointconstrain "ValveBiped.Bip01_R_Foot" x limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_R_Foot" y limit -30 30 0
	$jointconstrain "ValveBiped.Bip01_R_Foot" z limit -30 30 0
}

